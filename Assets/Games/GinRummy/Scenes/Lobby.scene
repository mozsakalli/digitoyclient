scene: Main
objects:
  - id: 1
    parent: 0
    name: Camera
    pos: 0 0 0
    rot: 0 0 0
    scale: 1 1 1
    components:
      - type: CameraComponent
        background: '#061018ff'
      - type: FitPerspectiveProjection
        fov: 30
        referenceResolution: 1920 800
  - id: 2
    parent: 0
    name: Root
    pos: 0 0 0
    rot: 0 0 0
    scale: 1 1 1
    components:
      - type: LayoutBox
        fill:
          color: '#10243aff'
          color2: '#061018ff'
          direction: Vertical
          type: Linear
        fitScreen: true
        font: 2f27a006689c4a7595833b3727d54190
        textAlign: Center
        textAlignV: Center
        textFill:
          color: '#ffffffff'
          type: Solid
        textSize: 72
        text@loc: lobby.root
