scene: Main
objects:
  - id: 1
    parent: 0
    name: Camera
    pos: 0 0 0
    rot: 0 0 0
    scale: 1 1 1
    components:
      - type: CameraComponent
        background: '#061018ff'
      - type: FitPerspectiveProjection
        fov: 30
        referenceResolution: 1920 1080
  - id: 2
    parent: 0
    name: Background
    pos: 0 0 0
    rot: 0 0 0
    scale: 1 1 1
    components:
      - type: LayoutBox
        fitScreen: true
        sprite: 56126938f14445edb55b7d3ba461bf60
        spriteFit: Cover
      - type: LoginFlow
        loginForm: 7
        agreement: 15
        progressRoot: 16
        progress: '17:ProgressRenderer:0'
        versionText: '18:LayoutBox:0'
        errorText: '19:LayoutBox:0'
        guestButton: '9:Button:0'
        facebookButton: '8:Button:0'
        appleButton: '14:Button:0'
        autoLoginLastType: false
        errorToast: '19:ClipToast:0'
      - type: RenderGroup
        Alpha: 1
  - id: 3
    parent: 2
    name: Logo
    pos: 0 0 0
    rot: 0 0 0
    scale: 1.52 1.52 1
    components:
      - type: LayoutBox
        anchorMax: 0.5 0.5
        anchorMin: 0.5 0.5
        anchoredPos: 0 -75
        height: 456
        width: 570
      - type: RenderGroup
        Alpha: 1
      - type: MovieClip
        Fps: 30
        FrameCount: 40
        Loop: false
        PlayOnStart: true
        Tracks:
          - Keys:
              - Ease: OutQuad
                Frame: 0
                Mode: Tween
                Value: 0 0 0 0
              - Ease: Linear
                Frame: 12
                Mode: Tween
                Value: 1 0 0 0
            Mask: 15
            Path: Alpha
            Target: '2:RenderGroup:0'
          - Keys:
              - Ease: OutQuad
                Frame: 0
                Mode: Tween
                Value: 0 0 0 0
              - Ease: Linear
                Frame: 6
                Mode: Tween
                Value: 1 0 0 0
            Mask: 15
            Path: Alpha
            Target: '5:RenderGroup:0'
          - Keys:
              - Ease: InQuad
                Frame: 0
                Mode: Tween
                Value: 0.2 0.2 1 0
              - Ease: Linear
                Frame: 14
                Mode: Tween
                Value: 1 1 1 0
            Mask: 15
            Path: Scale
            Target: '5:Transform:0'
          - Keys:
              - Ease: InQuad
                Frame: 0
                Mode: Tween
                Value: 2.5 2.5 1 0
              - Ease: Linear
                Frame: 14
                Mode: Tween
                Value: 1 1 1 0
            Mask: 15
            Path: Scale
            Target: '6:Transform:0'
          - Keys:
              - Ease: Linear
                Frame: 0
                Mode: Hold
                Value: 0 0 0 0
              - Ease: OutQuad
                Frame: 14
                Mode: Tween
                Value: 0 0 0 0
              - Ease: Linear
                Frame: 24
                Mode: Tween
                Value: 1 0 0 0
            Mask: 15
            Path: Alpha
            Target: '4:RenderGroup:0'
          - Keys:
              - Ease: Linear
                Frame: 0
                Mode: Hold
                Value: 0 -20 0 0
              - Ease: OutQuad
                Frame: 14
                Mode: Tween
                Value: 0 -20 0 0
              - Ease: Linear
                Frame: 24
                Mode: Tween
                Value: 0 -7 0 0
            Mask: 15
            Path: anchoredPos
            Target: '4:LayoutBox:0'
          - Keys:
              - Ease: Linear
                Frame: 0
                Mode: Hold
                Value: 1.52 1.52 1 0
              - Ease: OutQuad
                Frame: 14
                Mode: Tween
                Value: 1.52 1.52 1 0
              - Ease: OutBack
                Frame: 18
                Mode: Tween
                Value: 1.64 1.64 1 0
              - Ease: Linear
                Frame: 30
                Mode: Tween
                Value: 1.52 1.52 1 0
            Mask: 15
            Path: Scale
            Target: '3:Transform:0'
          - Keys:
              - Ease: Linear
                Frame: 0
                Mode: Hold
                Value: 0 600 0 0
              - Ease: OutBack
                Frame: 14
                Mode: Tween
                Value: 0 600 0 0
              - Ease: Linear
                Frame: 26
                Mode: Tween
                Value: 0 305 0 0
            Mask: 15
            Path: anchoredPos
            Target: '7:LayoutBox:0'
          - Keys:
              - Ease: Linear
                Frame: 0
                Mode: Hold
                Value: 0 0 0 0
              - Ease: OutQuad
                Frame: 14
                Mode: Tween
                Value: 0 0 0 0
              - Ease: Linear
                Frame: 22
                Mode: Tween
                Value: 1 0 0 0
            Mask: 15
            Path: Alpha
            Target: '7:RenderGroup:0'
          - Keys:
              - Ease: Linear
                Frame: 0
                Mode: Hold
                Value: 0 0 0 0
              - Ease: OutQuad
                Frame: 18
                Mode: Tween
                Value: 0 0 0 0
              - Ease: Linear
                Frame: 30
                Mode: Tween
                Value: 1 0 0 0
            Mask: 15
            Path: Alpha
            Target: '15:RenderGroup:0'
